# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used only by scripts/seed-user.ts. Server-only, never exposed to the client, never committed with a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings (Project Settings > Database > Connection string).
# Use the "Session" pooler (port 5432), NOT "Transaction" (port 6543): the transaction
# pooler hangs indefinitely instead of erroring once concurrent query batches from this
# app exceed a small in-flight count. See server/utils/db.ts for details.
DATABASE_URL=

# Credentials for the one-off seed script (scripts/seed-user.ts)
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
